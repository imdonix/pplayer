# API key for the web app. The frontend asks for this on first launch.
API_KEY=change-me

# Optional: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Optional: look up SponsorBlock segments on download (default: true)
# SPONSORBLOCK=true
# Optional: which categories to skip (default: sponsor,selfpromo,interaction)
# SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction
# Optional: override the SponsorBlock API base URL
# SPONSORBLOCK_API=https://sponsor.ajay.app
